---
// 静态页面布局：用于 src/pages 下的 .md 页面（如 about.md）
// Astro 5：静态 md 页面的 frontmatter 在 Astro.props.frontmatter，正文通过 <slot /> 渲染
import Base from './Base.astro';

const { frontmatter } = Astro.props;
const { title, description } = frontmatter;
---

<Base title={`${title} · 小九`} description={description}>
  <article>
    <header class="page-head">
      <h1>{title}</h1>
    </header>
    <div class="content">
      <slot />
    </div>
  </article>
</Base>
