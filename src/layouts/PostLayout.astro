---
// 文章详情布局：笔记 / 项目 / 生活共用 —— 阅读版式
import Base from './Base.astro';
import { render } from 'astro:content';

interface Props {
  entry: any;
  categoryLabel?: string;
  backHref?: string;
  backLabel?: string;
}

const { entry, categoryLabel, backHref, backLabel } = Astro.props;
const { Content, headings } = await render(entry);

const formatDate = (d: Date) => d.toISOString().slice(0, 10);
const siteName = '小九';
const base = import.meta.env.BASE_URL;
---

<Base title={`${entry.data.title} · ${siteName}`} description={entry.data.description}>
  <article class="post">
    <p class="back"><a href={backHref || base}>← {backLabel || '返回'}</a></p>

    <header class="head">
      <h1>{entry.data.title}</h1>
      <div class="meta">
        <time>{formatDate(entry.data.date)}</time>
        {categoryLabel && <span class="cat-badge">{categoryLabel}</span>}
        {entry.data.tags?.map((t: string) => (
          <a href={`${base}tags/${t}`}>#{t}</a>
        ))}
        {entry.data.tech?.map((t: string) => <span class="chip">{t}</span>)}
        {entry.data.status && <span class="chip">{entry.data.status}</span>}
      </div>
      {entry.data.description && <p class="desc">{entry.data.description}</p>}
    </header>

    {headings.length > 0 && (
      <details class="toc">
        <summary>目录</summary>
        <ol>
          {headings
            .filter((h: any) => h.depth <= 3)
            .map((h: any) => (
              <li style={`margin-left: ${(h.depth - 2) * 14}px`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
        </ol>
      </details>
    )}

    <div class="content">
      <Content />
    </div>

    <p class="back bottom"><a href={backHref || base}>← {backLabel || '返回'}</a></p>
  </article>
</Base>

<style>
  .post { max-width: 680px; margin: 0 auto; }
  .back { margin: 0 0 12px; font-size: 13.5px; color: var(--faint); }
  .back a { color: var(--faint); }
  .back a:hover { color: var(--accent); }
  .back.bottom { margin: 56px 0 0; padding-top: 24px; border-top: 1px solid var(--line); }

  .head { margin-bottom: 36px; }
  .head h1 {
    margin: 0 0 14px;
    font-size: 36px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    font-weight: 800;
  }
  .head .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--faint);
    font-size: 13.5px;
  }
  .head .meta time { font-family: var(--mono); font-size: 12.5px; }
  .head .meta a { color: var(--faint); }
  .head .meta a:hover { color: var(--accent); }
  .head .chip { font-size: 12px; color: #8a6a73; background: #f3e7e0; border-radius: 5px; padding: 1px 9px; }
  .head .desc { margin: 14px 0 0; color: var(--muted); font-size: 15px; }

  .toc {
    margin: 0 0 32px;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    font-size: 14px;
  }
  .toc summary { cursor: pointer; color: var(--muted); font-weight: 600; }
  .toc ol { margin: 10px 0 0; padding-left: 18px; }
  .toc li { margin: 3px 0; }
  .toc a { color: var(--muted); }
  .toc a:hover { color: var(--accent); }

  @media (max-width: 640px) {
    .head h1 { font-size: 28px; }
  }
</style>
