---
// 文章详情布局：笔记 / 项目 / 生活共用 —— 阅读版式
// v2: 目录改为嵌套层级 + 自动编号
import Base from './Base.astro';
import { render } from 'astro:content';

interface Props {
  entry: any;
  backHref?: string;
  backLabel?: string;
}

const { entry, backHref, backLabel } = Astro.props;
const { Content, headings } = await render(entry);

const formatDate = (d: Date) => d.toISOString().slice(0, 10);
const siteName = '小九';
const base = import.meta.env.BASE_URL;

// 把标题（忽略 h1，正文从 h2 起）整理成嵌套目录树：h2 为一级，其后的 h3 为其子项
const tocTree: { text: string; slug: string; children: { text: string; slug: string }[] }[] = [];
let currentH2: (typeof tocTree)[number] | null = null;
for (const h of headings) {
  if (h.depth <= 1 || h.depth > 3) continue;
  if (h.depth === 2) {
    currentH2 = { text: h.text, slug: h.slug, children: [] };
    tocTree.push(currentH2);
  } else if (h.depth === 3) {
    if (currentH2) {
      currentH2.children.push({ text: h.text, slug: h.slug });
    } else {
      currentH2 = { text: h.text, slug: h.slug, children: [] };
      tocTree.push(currentH2);
    }
  }
}
---

<Base title={`${entry.data.title} · ${siteName}`} description={entry.data.description}>
  <article class="post">
    <p class="back"><a href={backHref || base}>← {backLabel || '返回'}</a></p>

    <header class="head">
      <h1>{entry.data.title}</h1>
      <div class="meta">
        <time>{formatDate(entry.data.date)}</time>
        {entry.data.tags?.map((t: string) => (
          <a href={`${base}tags/${t}`}>#{t}</a>
        ))}
        {entry.data.tech?.map((t: string) => <span class="chip">{t}</span>)}
        {entry.data.status && <span class="chip">{entry.data.status}</span>}
      </div>
      {entry.data.description && <p class="desc">{entry.data.description}</p>}
    </header>

    {tocTree.length > 0 && (
      <details class="toc" open>
        <summary>目录</summary>
        <ol class="toc-list">
          {tocTree.map((h2) => (
            <li class="toc-h2">
              <a href={`#${h2.slug}`}>{h2.text}</a>
              {h2.children.length > 0 && (
                <ol class="toc-sub">
                  {h2.children.map((h3) => (
                    <li class="toc-h3">
                      <a href={`#${h3.slug}`}>{h3.text}</a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </details>
    )}

    <div class="content">
      <Content />
    </div>

    <p class="back bottom"><a href={backHref || base}>← {backLabel || '返回'}</a></p>
  </article>
</Base>

<style>
  .post { max-width: 680px; margin: 0 auto; }
  .back { margin: 0 0 12px; font-size: 13.5px; color: var(--faint); }
  .back a { color: var(--faint); }
  .back a:hover { color: var(--accent); }
  .back.bottom { margin: 56px 0 0; padding-top: 24px; border-top: 1px solid var(--line); }

  .head { margin-bottom: 36px; }
  .head h1 {
    margin: 0 0 14px;
    font-size: 36px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    font-weight: 800;
  }
  .head .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--faint);
    font-size: 13.5px;
  }
  .head .meta time { font-family: var(--mono); font-size: 12.5px; }
  .head .meta a { color: var(--faint); }
  .head .meta a:hover { color: var(--accent); }
  .head .chip { font-size: 12px; color: #8a6a73; background: #f3e7e0; border-radius: 5px; padding: 1px 9px; }
  .head .desc { margin: 14px 0 0; color: var(--muted); font-size: 15px; }

  /* ===== 目录：嵌套层级 + 自动编号 ===== */
  .toc {
    margin: 0 0 32px;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    font-size: 14px;
  }
  .toc summary { cursor: pointer; color: var(--muted); font-weight: 600; }

  .toc .toc-list {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    counter-reset: toc;
  }
  .toc .toc-list > .toc-h2 {
    counter-increment: toc;
    margin: 7px 0;
  }
  .toc .toc-list > .toc-h2 > a {
    display: block;
    font-weight: 600;
    color: var(--fg);
  }
  .toc .toc-list > .toc-h2 > a::before {
    content: counter(toc) ". ";
    color: var(--accent);
    font-weight: 700;
    margin-right: 2px;
  }

  .toc .toc-sub {
    list-style: none;
    margin: 5px 0 2px;
    padding-left: 24px;
    counter-reset: toc-sub;
    border-left: 1px solid var(--line);
  }
  .toc .toc-sub > .toc-h3 {
    counter-increment: toc-sub;
    margin: 4px 0;
  }
  .toc .toc-sub > .toc-h3 > a {
    color: var(--muted);
  }
  .toc .toc-sub > .toc-h3 > a::before {
    content: counter(toc) "." counter(toc-sub) " ";
    color: var(--faint);
    font-family: var(--mono);
    font-size: 12px;
  }

  .toc a:hover { color: var(--accent); }

  @media (max-width: 640px) {
    .head h1 { font-size: 28px; }
    .toc .toc-sub { padding-left: 16px; }
  }
</style>
