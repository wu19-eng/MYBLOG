---
// 全站基础布局：设计系统 + 页头 + 页脚
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '学习笔记 · 项目作品集 · 生活随笔' } = Astro.props;
const siteName = '小九';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <style is:global>
      /* ===== 设计系统：暖白极简杂志风 ===== */
      :root {
        --bg: #faf5ef;
        --card: #ffffff;
        --fg: #443543;
        --muted: #8a6a73;
        --faint: #b09aa0;
        --line: #e8dcd5;
        --accent: #642d3e;
        --accent-soft: #f3e7e0;
        --sans: "PingFang SC", "Microsoft YaHei", system-ui, -apple-system, "Segoe UI", sans-serif;
        --serif: Georgia, "Times New Roman", serif;
        --mono: ui-monospace, SFMono-Regular, Consolas, "Courier New", monospace;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: var(--sans);
        background: var(--bg);
        color: var(--fg);
        line-height: 1.8;
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--fg); text-decoration: none; transition: color 0.15s ease; }
      a:hover { color: var(--accent); }
      ::selection { background: var(--accent-soft); }

      main {
        width: min(760px, 100% - 40px);
        margin: 0 auto;
        padding: 56px 0 96px;
      }

      /* 装饰性小字（杂志感） */
      .kicker {
        font-family: var(--serif);
        font-style: italic;
        font-size: 13px;
        letter-spacing: 0.06em;
        color: var(--faint);
        margin: 0;
      }

      /* ===== 列表页页头 ===== */
      .page-head { margin-bottom: 36px; }
      .page-head h1 {
        margin: 8px 0 10px;
        font-size: 40px;
        line-height: 1.2;
        letter-spacing: -0.02em;
        font-weight: 800;
      }
      .page-head p { margin: 0; color: var(--muted); font-size: 15px; }

      /* ===== 分类筛选 ===== */
      .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 12px; }
      .tabs a {
        padding: 4px 14px;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--muted);
        font-size: 13.5px;
        background: transparent;
      }
      .tabs a:hover { border-color: var(--accent); color: var(--accent); }
      .tabs a.active { background: var(--fg); border-color: var(--fg); color: #fff; font-weight: 600; }

      /* ===== 时间流文章列表（blog 核心） ===== */
      .feed { list-style: none; padding: 0; margin: 0 0 48px; }
      .article-row {
        display: flex;
        gap: 28px;
        padding: 24px 0;
        border-bottom: 1px solid var(--line);
      }
      .article-row:first-child { padding-top: 8px; }
      .article-row time {
        flex: 0 0 88px;
        font-family: var(--mono);
        font-size: 13px;
        color: var(--faint);
        padding-top: 6px;
      }
      .article-row .body { flex: 1; min-width: 0; }
      .article-row h3 { margin: 0 0 6px; font-size: 20px; font-weight: 700; letter-spacing: -0.01em; line-height: 1.4; }
      .article-row h3 a { color: var(--fg); }
      .article-row h3 a:hover { color: var(--accent); }
      .article-row .desc { margin: 0 0 10px; color: var(--muted); font-size: 14.5px; }
      .article-row .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 12.5px; color: var(--faint); }
      .article-row .meta a { color: var(--faint); }
      .article-row .meta a:hover { color: var(--accent); }

      /* 分类小胶囊 */
      .cat-badge {
        display: inline-block;
        padding: 1px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 500;
        color: var(--accent);
        background: var(--accent-soft);
      }

      .empty { color: var(--faint); font-size: 15px; font-family: var(--serif); font-style: italic; }

      /* ===== 标签云 ===== */
      .tag-cloud { border-top: 1px dashed var(--line); padding-top: 24px; margin-top: 12px; }
      .tag-cloud h2 { font-size: 16px; margin: 0 0 12px; font-weight: 700; }
      .tag-cloud a {
        display: inline-block;
        margin: 0 8px 8px 0;
        padding: 2px 12px;
        border: 1px solid var(--line);
        border-radius: 999px;
        font-size: 13px;
        color: var(--muted);
      }
      .tag-cloud a:hover { color: var(--accent); border-color: var(--accent); }

      /* ===== 正文排版（阅读优化） ===== */
      .content { font-size: 16.5px; line-height: 1.9; }
      .content h2 {
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -0.01em;
        margin: 44px 0 14px;
      }
      .content h3 { font-size: 19px; font-weight: 700; margin: 32px 0 10px; }
      .content p { margin: 16px 0; }
      .content ul, .content ol { padding-left: 1.4em; margin: 16px 0; }
      .content li { margin: 6px 0; }
      .content blockquote {
        margin: 24px 0;
        padding: 2px 0 2px 22px;
        border-left: 2px solid var(--line);
        color: var(--muted);
      }
      .content code {
        padding: 2px 6px;
        border-radius: 5px;
        background: #f3e7e0;
        font-family: var(--mono);
        font-size: 0.88em;
      }
      .content pre {
        padding: 18px 20px;
        border-radius: 12px;
        background: #443543;
        color: #ebd988;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.7;
      }
      .content pre code { background: none; padding: 0; color: inherit; }
      .content table { border-collapse: collapse; width: 100%; margin: 20px 0; font-size: 14.5px; }
      .content th, .content td { border: 1px solid var(--line); padding: 10px 14px; text-align: left; }
      .content th { background: #faf5ef; font-weight: 600; }
      .content img { max-width: 100%; border-radius: 12px; }
      .content hr { border: none; border-top: 1px dashed var(--line); margin: 32px 0; }

      @media (max-width: 640px) {
        body { font-size: 15px; }
        main { padding: 32px 0 72px; }
        .page-head h1 { font-size: 30px; }
        .article-row { flex-direction: column; gap: 6px; }
        .article-row time { flex: none; }
      }
    </style>
  </head>
  <body>
    <Header siteName={siteName} />
    <main>
      <slot />
    </main>
    <Footer siteName={siteName} />
  </body>
</html>
