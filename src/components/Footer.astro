---
// 页脚
const { siteName } = Astro.props;
const year = new Date().getFullYear();
const email = 'you@example.com'; // TODO: 换成你的邮箱
const base = import.meta.env.BASE_URL;
---

<footer>
  <div class="wrap">
    <p>© {year} {siteName} · 用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建 · GitHub Pages 托管 · 无后端</p>
    <p>
      联系：<a href={`mailto:${email}`}>{email}</a>
      · <a href={`${base}about/`}>建站说明</a>
    </p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); background: var(--card); padding: 20px 0; color: var(--muted); font-size: 13px; }
  .wrap { width: min(880px, 100% - 32px); margin: 0 auto; }
  p { margin: 4px 0; }
</style>
