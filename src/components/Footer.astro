---
// 页脚：极简
const { siteName } = Astro.props;
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer>
  <div class="wrap">
    <p class="line">© {year} {siteName} <span class="sep">·</span> 用 Astro 构建 · GitHub Pages 托管 · 无后端</p>
    <p><a href={`${base}about/`}>建站说明</a></p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    background: var(--bg);
    padding: 28px 0;
    color: var(--faint);
    font-size: 13px;
  }
  .wrap {
    width: min(880px, 100% - 40px);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
  .line { margin: 0; }
  .sep { margin: 0 6px; color: var(--line); }
  footer a { color: var(--muted); }
  footer a:hover { color: var(--accent); }
  p { margin: 0; }
</style>
