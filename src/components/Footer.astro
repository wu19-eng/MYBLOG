---
// 页脚：极简
const base = import.meta.env.BASE_URL;
---

<footer>
  <div class="wrap">
    <p><a href={`${base}about/`}>建站说明</a></p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    background: var(--bg);
    padding: 28px 0;
    color: var(--faint);
    font-size: 13px;
  }
  .wrap {
    width: min(880px, 100% - 40px);
    margin: 0 auto;
    display: flex;
    justify-content: flex-end;
  }
  footer a { color: var(--muted); }
  footer a:hover { color: var(--accent); }
  p { margin: 0; }
</style>
