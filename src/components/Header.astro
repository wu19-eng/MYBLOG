---
// 顶部导航：极简细导航
const { siteName } = Astro.props;
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const nav = [
  { href: `${base}`, label: '首页' },
  { href: `${base}notes/`, label: '学习笔记' },
  { href: `${base}projects/`, label: '项目作品集' },
  { href: `${base}life/`, label: '生活随笔' },
  { href: `${base}about/`, label: '关于我' },
];
---

<header>
  <div class="wrap">
    <a class="brand" href={base}>{siteName}</a>
    <nav>
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={{
              active: item.href === base ? path === item.href : path.startsWith(item.href),
            }}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(250, 245, 239, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .wrap {
    width: min(880px, 100% - 40px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    gap: 12px;
  }
  .brand {
    font-weight: 800;
    font-size: 17px;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .brand:hover { color: var(--accent); }
  nav { display: flex; flex-wrap: wrap; gap: 4px 22px; }
  nav a { color: var(--muted); font-size: 14px; white-space: nowrap; }
  nav a:hover { color: var(--fg); }
  nav a.active { color: var(--fg); font-weight: 700; }
  @media (max-width: 640px) {
    .wrap { flex-direction: column; padding: 10px 0; }
    nav { justify-content: center; gap: 4px 16px; }
    nav a { font-size: 13px; }
  }
</style>
