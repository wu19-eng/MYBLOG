---
// 项目作品集列表页：卡片式
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const categoryLabels: Record<string, string> = {
  'course-design': '课程设计',
  simulation: '仿真项目',
  competition: '竞赛',
};

const all = (await getCollection('projects')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const active = Astro.url.searchParams.get('category') ?? 'all';
const filtered =
  active === 'all' ? all : all.filter((p) => p.data.category === active);
const formatDate = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title="项目作品集 · 小九" description="课程设计、仿真项目与竞赛作品，项目介绍 + 踩坑复盘。">
  <header class="page-head">
    <h1>项目作品集</h1>
    <p>课程设计 · 仿真项目 · 竞赛。每个项目包含方案介绍与踩坑复盘，成果尽量量化。</p>
  </header>

  <nav class="tabs">
    <a href={`${base}projects/`} class:list={{ active: active === 'all' }}>全部</a>
    {
      Object.entries(categoryLabels).map(([key, label]) => (
        <a href={`${base}projects/?category=${key}`} class:list={{ active: active === key }}>
          {label}
        </a>
      ))
    }
  </nav>

  <div class="grid">
    {
      filtered.map((p) => (
        <a class="card" href={`${base}projects/${p.id}/`}>
          <div class="card-head">
            <span class="cat-badge">{categoryLabels[p.data.category]}</span>
            <span class="date">{formatDate(p.data.date)}</span>
          </div>
          <div class="card-title">{p.data.title}</div>
          {p.data.description && <p class="desc">{p.data.description}</p>}
          <div class="tech">
            {p.data.tech?.map((t) => <span class="chip">{t}</span>)}
          </div>
          <div class="foot">
            <span class="status">{p.data.status}</span>
            <span class="more">查看项目 →</span>
          </div>
        </a>
      ))
    }
  </div>

  {
    filtered.length === 0 && (
      <p class="empty">该分类下还没有项目，去 <a href={`${base}projects/`}>全部</a> 看看，或新建一篇吧。</p>
    )
  }
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .card {
    display: flex; flex-direction: column; gap: 8px;
    padding: 18px; border: 1px solid var(--line); border-radius: 10px;
    background: var(--card); color: var(--fg);
  }
  .card:hover { text-decoration: none; box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08); transform: translateY(-2px); }
  .card-head { display: flex; justify-content: space-between; align-items: center; }
  .date { color: var(--muted); font-size: 12px; }
  .card-title { font-size: 17px; font-weight: 700; line-height: 1.4; }
  .desc { margin: 0; color: #475569; font-size: 13px; flex: 1; }
  .tech { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { font-size: 12px; color: var(--projects); background: #ecfdf5; border-radius: 4px; padding: 1px 8px; }
  .foot { display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed var(--line); padding-top: 8px; }
  .status { font-size: 12px; color: var(--muted); }
  .more { font-size: 13px; color: var(--projects); font-weight: 600; }
  .empty { color: var(--muted); }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
