---
// 项目作品集列表页：精修卡片
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const categoryLabels: Record<string, string> = {
  'course-design': '课程设计',
  simulation: '仿真项目',
  competition: '竞赛',
};

const all = (await getCollection('projects')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const active = Astro.url.searchParams.get('category') ?? 'all';
const filtered =
  active === 'all' ? all : all.filter((p) => p.data.category === active);
const formatDate = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title="项目作品集 · 小九" description="课程设计、仿真项目与竞赛作品，项目介绍 + 踩坑复盘。">
  <header class="page-head">
    <p class="kicker">Portfolio</p>
    <h1>项目作品集</h1>
    <p>课程设计 · 仿真项目 · 竞赛。每个项目包含方案介绍与踩坑复盘，成果尽量量化。</p>
  </header>

  <nav class="tabs">
    <a href={`${base}projects/`} class:list={{ active: active === 'all' }}>全部</a>
    {
      Object.entries(categoryLabels).map(([key, label]) => (
        <a href={`${base}projects/?category=${key}`} class:list={{ active: active === key }}>
          {label}
        </a>
      ))
    }
  </nav>

  <div class="grid">
    {
      filtered.map((p) => (
        <a class="card" href={`${base}projects/${p.id}/`}>
          <div class="card-top">
            <span class="cat-badge">{categoryLabels[p.data.category]}</span>
            <time>{formatDate(p.data.date)}</time>
          </div>
          <div class="card-title">{p.data.title}</div>
          {p.data.description && <p class="desc">{p.data.description}</p>}
          <div class="tech">
            {p.data.tech?.map((t) => <span class="chip">{t}</span>)}
          </div>
          <div class="card-foot">
            <span class="status">{p.data.status}</span>
            <span class="more">查看 →</span>
          </div>
        </a>
      ))
    }
  </div>

  {
    filtered.length === 0 && (
      <p class="empty">这个分类还没有项目，去 <a href={`${base}projects/`}>全部</a> 看看。</p>
    )
  }
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    color: var(--fg);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .card:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(24, 24, 27, 0.06);
    border-color: #d4d4d8;
  }
  .card-top { display: flex; justify-content: space-between; align-items: center; }
  .card-top time { font-family: var(--mono); font-size: 12px; color: var(--faint); }
  .card-title { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; line-height: 1.4; }
  .desc { margin: 0; color: var(--muted); font-size: 13.5px; flex: 1; }
  .tech { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    font-size: 12px;
    color: #4b5563;
    background: #f3e7e0;
    border-radius: 5px;
    padding: 1px 9px;
  }
  .card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: 10px;
  }
  .status { font-size: 12px; color: var(--faint); }
  .more { font-size: 13px; color: var(--accent); font-weight: 600; }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
