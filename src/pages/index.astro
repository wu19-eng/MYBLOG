---
// 首页：blog 形式 —— Hero + 统一时间流 + 板块索引
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const life = (await getCollection('life')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const formatDate = (d: Date) => d.toISOString().slice(0, 10);

// 三类内容合并为统一时间流
const feed = [
  ...notes.map((n) => ({
    date: n.data.date,
    title: n.data.title,
    desc: n.data.description,
    url: `${base}notes/${n.id}/`,
    tags: n.data.tags ?? [],
  })),
  ...projects.map((p) => ({
    date: p.data.date,
    title: p.data.title,
    desc: p.data.description,
    url: `${base}projects/${p.id}/`,
    tags: p.data.tech ?? [],
  })),
  ...life.map((l) => ({
    date: l.data.date,
    title: l.data.title,
    desc: l.data.description,
    url: `${base}life/${l.id}/`,
    tags: l.data.tags ?? [],
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const sections = [
  { href: `${base}notes/`, num: '01', title: '学习笔记' },
  { href: `${base}projects/`, num: '02', title: '项目作品集' },
  { href: `${base}life/`, num: '03', title: '生活随笔' },
  { href: `${base}about/`, num: '04', title: '关于我' },
];

// ===== 站内搜索索引（无后端：构建时把全文索引内联进页面） =====
const rawFiles = import.meta.glob('../content/**/*.md', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const cleanBody = (raw: string) =>
  raw
    .replace(/^---[\s\S]*?---/, '') // 去掉 frontmatter
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ') // 去图片
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1') // 链接保留文字
    .replace(/[#*`>_~\-\[\]()]/g, ' ') // 去标记符号
    .replace(/\s+/g, ' ')
    .trim();

const buildIndex = (entry: any, section: string, label: string, tags: string[]) => {
  const raw = rawFiles[`../content/${section}/${entry.id}.md`] ?? '';
  const text =
    `${label} ${entry.data.title} ${entry.data.description} ${tags.join(' ')} ${cleanBody(raw)}`.toLowerCase();
  return {
    title: entry.data.title,
    date: formatDate(entry.data.date),
    url: `${base}${section}/${entry.id}/`,
    desc: entry.data.description,
    label,
    tags,
    text,
  };
};

const searchIndex = [
  ...notes.map((n) => buildIndex(n, 'notes', '学习笔记', n.data.tags ?? [])),
  ...projects.map((p) => buildIndex(p, 'projects', '项目作品集', p.data.tech ?? [])),
  ...life.map((l) => buildIndex(l, 'life', '生活随笔', l.data.tags ?? [])),
];

const searchIndexJson = JSON.stringify(searchIndex).replace(/</g, '\\u003c');
---

<Base title="小九的个人小屋" description="数字时代的留痕">

  <section class="hero">
    <p class="kicker">Notes · Projects · Life</p>
    <h1 class="display">
      <span class="w">own</span>
      <span class="w">the</span>
      <span class="w">moment</span>
    </h1>
    <p class="slogan">简单记录</p>
  </section>

  <section class="search-sec">
    <input
      class="search-input"
      type="search"
      placeholder="搜索标题 / 标签 / 关键词"
      aria-label="站内搜索"
      autocomplete="off"
    />
    <div class="search-results" hidden>
      <p class="search-count"></p>
      <ul class="feed search-list"></ul>
      <p class="search-empty">没有找到相关内容，换个词试试。</p>
    </div>
  </section>

  <section class="feed-sec">
    <div class="sec-head">
      <h2>最新动态</h2>
      <a class="more" href={`${base}notes/`}>全部文章 →</a>
    </div>

    {
      feed.length > 0 ? (
        <ul class="feed">
          {feed.map((item) => (
            <li class="article-row">
              <time>{formatDate(item.date)}</time>
              <div class="body">
                <h3><a href={item.url}>{item.title}</a></h3>
                {item.desc && <p class="desc">{item.desc}</p>}
                <div class="meta">
                  {item.tags.map((t: string) => (
                    <a class="tag-link" href={`${base}tags/${t}`}>#{t}</a>
                  ))}
                </div>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">第一篇内容正在路上——会是一篇笔记、一个项目，或一段随笔。</p>
      )
    }
  </section>

  <nav class="index-nav">
    {
      sections.map((s) => (
        <a class="index-row" href={s.href}>
          <span class="num">{s.num}</span>
          <span class="idx-title">{s.title}</span>
        </a>
      ))
    }
  </nav>
</Base>

<style>
  .hero { padding: 40px 0 48px; border-bottom: 1px solid var(--line); }
  .hero .display {
    display: flex;
    align-items: baseline;
    gap: 0.45em;
    margin: 16px 0 14px;
    font-size: clamp(46px, 9vw, 74px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 800;
    color: var(--fg);
    transition: gap 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero .display .w {
    display: inline-block;
    transform-origin: center;
    font-weight: 800;
    color: var(--fg);
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s ease;
  }
  /* 聚焦效果：hover 词放大并沿方向偏移，其余缩小反向偏移 */
  .hero .display:hover { gap: 0.1em; }
  /* 缩小：own 靠左、the 居中、moment 靠右 */
  .hero .display:hover .w:nth-child(1) { transform: translateX(-0.18em) scale(0.78); color: var(--faint); }
  .hero .display:hover .w:nth-child(2) { transform: scale(0.78); color: var(--faint); }
  .hero .display:hover .w:nth-child(3) { transform: translateX(0.18em) scale(0.78); color: var(--faint); }
  /* 放大：own 靠右、the 居中、moment 靠左（覆盖缩小） */
  .hero .display .w:nth-child(1):hover { transform: translateX(0.18em) scale(1.3); color: #642d3e; }
  .hero .display .w:nth-child(2):hover { transform: scale(1.3); color: #642d3e; }
  .hero .display .w:nth-child(3):hover { transform: translateX(-0.18em) scale(1.3); color: #642d3e; }
  /* the 向另一侧靠拢：own 放大 → the 右靠；moment 放大 → the 左靠（距离相同） */
  .hero .display .w:first-child:hover ~ .w:nth-child(2) {
    transform: translateX(0.5em) scale(0.78);
  }
  .hero .display:has(.w:last-child:hover) .w:nth-child(2) {
    transform: translateX(-0.5em) scale(0.78);
  }
  .hero .slogan { margin: 0 0 10px; color: var(--muted); font-size: 15px; }
  .hero .intro { margin: 0; color: var(--muted); font-size: 15px; }

  /* ===== 站内搜索 ===== */
  .search-sec { padding: 28px 0 4px; }
  .search-input {
    width: 100%;
    box-sizing: border-box;
    padding: 13px 18px;
    font-size: 15px;
    font-family: inherit;
    color: var(--fg);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .search-input::placeholder { color: var(--faint); }
  .search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .search-results { margin-top: 14px; }
  .search-count { margin: 0 0 4px; font-family: var(--mono); font-size: 12.5px; color: var(--faint); }
  .search-list { margin-bottom: 0 !important; }
  .search-empty { color: var(--faint); font-size: 14.5px; font-family: var(--serif); font-style: italic; }
  .s-label { font-size: 12px; font-weight: 600; color: var(--accent); }

  .feed-sec { padding: 48px 0 8px; }
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .sec-head h2 { margin: 0; font-size: 15px; font-weight: 700; letter-spacing: 0.02em; }
  .more { font-size: 13.5px; color: var(--muted); }
  .more:hover { color: var(--accent); }

  .index-nav { margin-top: 48px; border-top: 1px solid var(--line); }
  .index-row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
    color: var(--fg);
    transform-origin: left center;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s ease;
  }
  .index-row:hover {
    color: var(--accent);
    transform: scale(1.05);
  }
  .num { font-family: var(--mono); font-size: 12.5px; color: var(--faint); }
  .idx-title { font-size: 17px; font-weight: 700; }

  @media (max-width: 640px) {
    .hero .display { font-size: 40px; line-height: 1.1; }
  }
</style>

<script is:inline define:vars={{ searchIndexJson, base }}>
  const SEARCH_INDEX = JSON.parse(searchIndexJson);
  const BASE = base;
  const input = document.querySelector('.search-input');
  const box = document.querySelector('.search-results');
  const listEl = document.querySelector('.search-list');
  const countEl = document.querySelector('.search-count');
  const emptyEl = document.querySelector('.search-empty');
  const esc = (s) =>
    String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const render = () => {
    const q = (input.value || '').trim().toLowerCase();
    if (!q) {
      box.hidden = true;
      return;
    }
    const tokens = q.split(/\s+/).filter(Boolean);
    const hits = SEARCH_INDEX.filter((it) => tokens.every((t) => it.text.includes(t)));
    countEl.textContent = hits.length + ' 条结果';
    if (!hits.length) {
      emptyEl.hidden = false;
      listEl.innerHTML = '';
    } else {
      emptyEl.hidden = true;
      listEl.innerHTML = hits
        .map((it) => {
          const desc = it.desc ? '<p class="desc">' + esc(it.desc) + '</p>' : '';
          const tags = (it.tags || [])
            .map((t) => '<a class="tag-link" href="' + BASE + 'tags/' + encodeURIComponent(t) + '">#' + esc(t) + '</a>')
            .join('');
          return (
            '<li class="article-row"><time>' +
            esc(it.date) +
            '</time><div class="body"><h3><a href="' +
            esc(it.url) +
            '">' +
            esc(it.title) +
            '</a></h3>' +
            desc +
            '<div class="meta"><span class="s-label">' +
            esc(it.label) +
            '</span>' +
            tags +
            '</div></div></li>'
          );
        })
        .join('');
    }
    box.hidden = false;
  };
  input.addEventListener('input', render);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      input.value = '';
      render();
      input.blur();
    }
  });
</script>
