---
// 首页：blog 形式 —— Hero + 统一时间流 + 板块索引
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const life = (await getCollection('life')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const noteLabels: Record<string, string> = {
  electrical: '电气专业课',
  math: '考研数一',
  simulink: 'Simulink 仿真',
  python: 'Python 笔记',
};
const projectLabels: Record<string, string> = {
  'course-design': '课程设计',
  simulation: '仿真项目',
  competition: '竞赛',
};
const lifeLabels: Record<string, string> = {
  essays: '随笔',
  reading: '读书',
  photos: '照片',
};

const formatDate = (d: Date) => d.toISOString().slice(0, 10);

// 三类内容合并为统一时间流
const feed = [
  ...notes.map((n) => ({
    date: n.data.date,
    title: n.data.title,
    desc: n.data.description,
    url: `${base}notes/${n.id}/`,
    badge: noteLabels[n.data.category] ?? '',
    tags: n.data.tags ?? [],
  })),
  ...projects.map((p) => ({
    date: p.data.date,
    title: p.data.title,
    desc: p.data.description,
    url: `${base}projects/${p.id}/`,
    badge: projectLabels[p.data.category] ?? '',
    tags: p.data.tech ?? [],
  })),
  ...life.map((l) => ({
    date: l.data.date,
    title: l.data.title,
    desc: l.data.description,
    url: `${base}life/${l.id}/`,
    badge: lifeLabels[l.data.category] ?? '',
    tags: l.data.tags ?? [],
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const sections = [
  { href: `${base}notes/`, num: '01', title: '学习笔记', desc: '电气专业课 · 考研数一 · Simulink 仿真 · Python' },
  { href: `${base}projects/`, num: '02', title: '项目作品集', desc: '课程设计 · 仿真项目 · 竞赛，附踩坑复盘' },
  { href: `${base}life/`, num: '03', title: '生活随笔', desc: '随笔 · 读书 · 照片' },
  { href: `${base}about/`, num: '04', title: '关于我', desc: '个人简介 · 建站说明' },
];
---

<Base title="小九 · 学习笔记、项目作品集与生活随笔" description="一个电气人的学习轨迹与工程实践——把笔记写清楚，把项目做扎实，把生活留个记录。">

  <section class="hero">
    <p class="kicker">Notes · Projects · Life</p>
    <h1 class="display">
      <span class="w">own</span>{' '}
      <span class="w">the</span>{' '}
      <span class="w">moment</span>
    </h1>
    <p class="slogan">把笔记写清楚，把项目做扎实，把生活留个记录。</p>
    <p class="intro">
      【姓名】· 电气工程及其自动化专业在读 · 备考研究生（数一 · 英一 · 电路）
      <br />
      这里是我的数字自留地，也是我的求职名片。
    </p>
  </section>

  <section class="feed-sec">
    <div class="sec-head">
      <h2>最新动态</h2>
      <a class="more" href={`${base}notes/`}>全部文章 →</a>
    </div>

    {
      feed.length > 0 ? (
        <ul class="feed">
          {feed.map((item) => (
            <li class="article-row">
              <time>{formatDate(item.date)}</time>
              <div class="body">
                <h3><a href={item.url}>{item.title}</a></h3>
                {item.desc && <p class="desc">{item.desc}</p>}
                <div class="meta">
                  {item.badge && <span class="cat-badge">{item.badge}</span>}
                  {item.tags.map((t: string) => (
                    <a class="tag-link" href={`${base}tags/${t}`}>#{t}</a>
                  ))}
                </div>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">第一篇内容正在路上——会是一篇笔记、一个项目，或一段随笔。</p>
      )
    }
  </section>

  <nav class="index-nav">
    {
      sections.map((s) => (
        <a class="index-row" href={s.href}>
          <span class="num">{s.num}</span>
          <span class="idx-body">
            <span class="idx-title">{s.title}</span>
            <span class="idx-desc">{s.desc}</span>
          </span>
          <span class="arrow">→</span>
        </a>
      ))
    }
  </nav>
</Base>

<style>
  .hero { padding: 40px 0 48px; border-bottom: 1px solid var(--line); }
  .hero .display {
    margin: 16px 0 14px;
    font-size: clamp(46px, 9vw, 74px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 800;
    color: var(--fg);
  }
  .hero .display .w {
    display: inline-block;
    transform-origin: center;
    font-weight: 800;
    color: var(--fg);
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s ease;
  }
  /* 聚焦效果：靠近某个词 → 该词放大变色，其余缩小变灰 */
  .hero .display:hover .w { transform: scale(0.82); color: var(--faint); }
  .hero .display .w:hover { transform: scale(1.25); color: #d97706; }
  .hero .slogan { margin: 0 0 10px; color: var(--muted); font-size: 15px; }
  .hero .intro { margin: 0; color: var(--muted); font-size: 15px; }

  .feed-sec { padding: 48px 0 8px; }
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .sec-head h2 { margin: 0; font-size: 15px; font-weight: 700; letter-spacing: 0.02em; }
  .more { font-size: 13.5px; color: var(--muted); }
  .more:hover { color: var(--accent); }

  .index-nav { margin-top: 48px; border-top: 1px solid var(--line); }
  .index-row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
    color: var(--fg);
  }
  .index-row:hover { color: var(--accent); }
  .num { font-family: var(--mono); font-size: 12.5px; color: var(--faint); }
  .idx-body { flex: 1; display: flex; flex-direction: column; gap: 2px; }
  .idx-title { font-size: 17px; font-weight: 700; }
  .idx-desc { font-size: 13px; color: var(--muted); }
  .arrow { color: var(--faint); font-size: 15px; }

  @media (max-width: 640px) {
    .hero .display { font-size: 40px; line-height: 1.1; }
  }
</style>
